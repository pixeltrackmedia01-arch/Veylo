# ---------------------------------------------------------------------------
# GroupDrive environment variables
# Copy to .env.local for local development. Never commit real credentials.
# ---------------------------------------------------------------------------

# Public URL of the site (used in emails, auth redirects, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). Only these two are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used for scheduled jobs, email dispatch, rate limiting and
# signed file links. NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for /api/cron/process-batches (min 16 chars; generate with `openssl rand -hex 32`)
CRON_SECRET=

# Email notifications. Leave EMAIL_PROVIDER empty for development mode: nothing
# is sent and email notifications are recorded as "skipped".
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="GroupDrive <notifications@your-domain.in>"

# Set to true only after configuring an SMS provider in Supabase Auth (Phone).
NEXT_PUBLIC_PHONE_OTP_ENABLED=false
